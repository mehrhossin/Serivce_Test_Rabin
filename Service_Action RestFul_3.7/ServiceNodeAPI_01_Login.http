  "Game":    "Tesla",
  "Bridge":  1,
  "DropArm": true,
  "key":     0,
  "color":   "3",
  "sec":     5,
  "drops":   1,
  "trail":   7,
  "act_pct": 80,
  "flags":   1,
  "length":  5
}


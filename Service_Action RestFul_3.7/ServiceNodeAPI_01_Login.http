### 3. 💧 DropArm — آماده کردن Drop
### Opcode: 0x72
### پارامترها:
###   key     : 0 
###   addr    : 3  شماره نود (بین نود 1 تا 16)
###   color   : 1=Blue 2=Yellow 3=Pink 4=Orange 5=White
###   sec     : زمان (ثانیه)
###   drops   : تعداد قطره (1-8)
###   trail   : طول دنباله (1-8)
###   act_pct : درصد فعال‌سازی (0-100)
###   flags   : فلگ رفتار (0 یا 1)
###   length  : طول مسیر (تعداد پیکسل)
### ═══════════════════════════════════════════



PUT http://127.0.0.1:9001/api/nodes/set
Authorization: Bearer RBUS-TEST-TOKEN-0001
Content-Type: application/json

{
  "Game":    "Tesla",
  "Bridge":  1,
  "DropArm": true,
  "key":     0,
  "addr":6,
  "color":   "3",
  "sec":     5,
  "drops":   1,
  "trail":   10,
  "act_pct": 80,
  "flags":   1,
  "length":  5
}


# {
#   "statusCode": 200,
#   "message": "success",
#   "ok": true,
#   "applied": {
#     "ok": true,
#     "game": "Tesla",
#     "bridges": [
#       "Bridge-1"
#     ],
#     "results": [
#       {
#         "ok": true,
#         "bridge": "Bridge-1",
#         "opcode": "0x72",
#         "payload": "00ff008005010a500105",
#         "field": "DropArm"
#       }
#     ]
#   }
# }


### ═══════════════════════════════════════════
